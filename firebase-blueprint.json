          "maxLength": 2000
        },
        "source": {
          "type": "string",
          "enum": ["gemini-server", "self-practice"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "scenarioId",
