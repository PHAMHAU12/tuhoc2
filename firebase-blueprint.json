{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private learner profile, preferences, daily study goal, and skill progress for an authenticated TỰ HỌC TIẾNG ANH - PHẠM HẬU user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 500
        },
        "currentCefr": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "targetCefr": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "dailyGoalMinutes": {
          "type": "integer"
        },
        "todayMinutes": {
          "type": "integer"
        },
        "streakDays": {
          "type": "integer"
        },
        "vocabularyLearnedCount": {
          "type": "integer"
        },
        "preferredAccent": {
          "type": "string",
          "enum": ["US", "UK"]
        },
        "speechRate": {
          "type": "number"
        },
        "showVietnameseHints": {
          "type": "boolean"
        },
        "showIpaNotation": {
          "type": "boolean"
        },
        "skillScores": {
          "type": "object"
        },
        "weeklyMinutes": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "avatarUrl",
        "currentCefr",
        "targetCefr",
        "dailyGoalMinutes",
        "todayMinutes",
        "streakDays",
        "vocabularyLearnedCount",
        "preferredAccent",
        "speechRate",
        "showVietnameseHints",
        "showIpaNotation",
        "skillScores",
        "weeklyMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "CatalogVocabulary": {
      "title": "CatalogVocabulary",
      "description": "Shared starter dataset vocabulary item preserving every original JSON field and document ID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "word": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ipa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "part_of_speech": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "meaning_vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "example_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "example_vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "id",
        "level",
        "topic",
        "word",
        "ipa",
        "part_of_speech",
        "meaning_vi",
        "example_en",
        "example_vi"
      ]
    },
    "CatalogConversationScenario": {
      "title": "CatalogConversationScenario",
