        "topic",
        "context_vi",
        "roles",
        "dialogue",
        "useful_phrases",
        "ai_coaching_instruction_vi"
      ]
    },
    "CatalogSpeakingTask": {
      "title": "CatalogSpeakingTask",
      "description": "Shared starter dataset speaking task preserving every original JSON field and document ID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "prompt_en": {
          "type": "string",
          "minLength": 1,
