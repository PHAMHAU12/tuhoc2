          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lessonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "titleVi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "titleEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cefr": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "skillVi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
