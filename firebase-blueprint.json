      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "context_vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
