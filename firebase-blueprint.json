  },
  "firestore": {
    "/vocabulary/{vocabId}": {
      "schema": { "$ref": "#/entities/CatalogVocabulary" },
      "description": "Starter dataset vocabulary items readable by authenticated learners and managed by admin."
    },
    "/conversation_scenarios/{scenarioId}": {
      "schema": { "$ref": "#/entities/CatalogConversationScenario" },
      "description": "Starter dataset conversation scenarios readable by authenticated learners and managed by admin."
    },
    "/speaking_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/CatalogSpeakingTask" },
      "description": "Starter dataset speaking tasks readable by authenticated learners and managed by admin."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private learner profile, CEFR levels, study goals, and skill metrics isolated by userId."
    },
    "/users/{userId}/vocabularyBookmarks/{wordId}": {
      "schema": { "$ref": "#/entities/VocabularyBookmark" },
      "description": "Per-user vocabulary bookmark and mastery status."
    },
    "/users/{userId}/completedSpeakingTasks/{taskId}": {
      "schema": { "$ref": "#/entities/CompletedSpeakingTask" },
      "description": "Per-user completed speaking task status and self-assessment checklist."
    },
    "/users/{userId}/completedLessons/{lessonId}": {
      "schema": { "$ref": "#/entities/CompletedLesson" },
      "description": "Per-user completed lesson records."
    },
    "/users/{userId}/speakingHistory/{sessionId}": {
      "schema": { "$ref": "#/entities/SpeakingHistoryItem" },
      "description": "Per-user AI speaking practice history and feedback."
    },
    "/users/{userId}/testResults/{resultId}": {
      "schema": { "$ref": "#/entities/TestResult" },
      "description": "Per-user pronunciation drill and assessment results."
    }
  }
}
