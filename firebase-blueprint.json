        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "scenarioTitleVi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cefr": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "promptEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
