        "lessonId",
        "titleVi",
        "titleEn",
        "cefr",
        "skillVi",
        "durationMinutes",
        "scorePercent",
        "routeTarget",
        "completedAt"
      ]
    },
    "SpeakingHistoryItem": {
      "title": "SpeakingHistoryItem",
