    "VocabularyBookmark": {
      "title": "VocabularyBookmark",
      "description": "User-specific vocabulary bookmark and mastery status under a learner profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "wordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "word": {
          "type": "string",
          "minLength": 1,
