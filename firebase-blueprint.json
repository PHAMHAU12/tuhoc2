        },
        "mastered": {
          "type": "boolean"
        },
        "bookmarked": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "wordId", "word", "cefr", "mastered", "bookmarked", "updatedAt"]
    },
    "CompletedSpeakingTask": {
      "title": "CompletedSpeakingTask",
      "description": "User-specific completion and self-assessment record for a speaking_tasks item.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "promptEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "checkedCriteria": {
          "type": "array"
        },
        "completed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "taskId",
        "topic",
        "level",
        "promptEn",
        "checkedCriteria",
        "completed",
        "notes",
        "updatedAt"
      ]
    },
    "CompletedLesson": {
